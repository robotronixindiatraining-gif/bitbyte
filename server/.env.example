# BitByte server configuration — PLACEHOLDERS ONLY. Copy to server/.env for local development.
# Never commit a real .env file. In production, set these in the host's secret store (docs/DEPLOYMENT.md).

# --- Used since Stage 03 -------------------------------------------------------------
# development | test | production
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# fatal | error | warn | info | debug | trace | silent  (default: info; debug in development)
LOG_LEVEL=
# Human-readable logs (development only). Defaults to true in development, false otherwise.
LOG_PRETTY=
# Canonical public origin. Required in production.
PUBLIC_SITE_URL=http://localhost:5173
# MongoDB connection string. Leave empty to run without a database (health reports "disabled").
# Required in production (managed MongoDB, e.g. Atlas).
MONGODB_URI=mongodb://127.0.0.1:27017/bitbyte
# Number of trusted reverse-proxy hops in front of the app (0 locally).
TRUST_PROXY_HOPS=0
# Built client directory served in production (default: ../client/dist).
CLIENT_DIST_DIR=

# --- Used since Stage 04: admin sessions and two-factor authentication (D-011, D-039) ---
# Extra origins allowed to send state-changing requests (comma-separated). PUBLIC_SITE_URL's origin
# is always allowed; http://localhost:5173 is added automatically in development.
ALLOWED_ORIGINS=
# Session cookie base name; production adds the __Host- prefix automatically.
SESSION_COOKIE_NAME=bb_sid
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=12
# SECRETS — required in production; generate with `npm run secrets:generate` and keep them out of Git.
# Changing TOTP_ENCRYPTION_KEY makes existing 2FA enrolments unreadable (re-enrol with admin:reset-2fa).
TOTP_ENCRYPTION_KEY=
RECOVERY_CODE_PEPPER=
IP_HASH_SALT=

# --- Used since Stage 05: media, e-mail, bot protection, jobs and SEO -----------------
# PRODUCTION CONFIGURATION FOR CLOUDINARY, RESEND AND TURNSTILE IS PENDING: no real credentials
# have been supplied or tested yet. Development and tests need none of them.

# Media storage (D-018, D-049): "local" (development; files in MEDIA_LOCAL_DIR, served at /uploads)
# or "cloudinary". Production refuses "local"; without "cloudinary" production uploads answer 503.
MEDIA_DRIVER=local
MEDIA_LOCAL_DIR=./uploads
# Cloudinary credentials (server only; never sent to the browser). Format:
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# Notification e-mail (D-019, D-052): "log" sends nothing (development); "resend" sends via Resend.
MAIL_DRIVER=log
# Required for MAIL_DRIVER=resend. The sender domain must be verified in Resend first.
RESEND_API_KEY=
MAIL_FROM=
# Fallback recipients for new-lead notices when the published leadForm settings name none
# (comma-separated).
LEAD_NOTIFICATION_EMAILS=

# Cloudflare Turnstile (D-020, D-051). Without a secret the contact form answers 503.
# Locally you may use Cloudflare's documented TEST secret keys (they verify nothing real).
TURNSTILE_SECRET_KEY=
# Hostnames tokens may be issued for (comma-separated). Default: the host of PUBLIC_SITE_URL.
TURNSTILE_ALLOWED_HOSTNAMES=

# Background jobs (retention purge, notification retries) run inside the server process.
# Default: on, except in tests. With several instances, enable them on one only.
JOBS_ENABLED=

# Search engines may index the site only when NODE_ENV=production AND this is true (D-050).
# Leave false on staging and until launch.
ROBOTS_ALLOW_INDEXING=false

# --- Stage 10: enable only after domain verification (D-028) ---------------------------
# Host every request is redirected to (e.g. www.example.com). Leave empty until verified.
CANONICAL_HOST=

# Optional external error tracking (D-022) — disabled while unset
# ERROR_TRACKING_DSN=
