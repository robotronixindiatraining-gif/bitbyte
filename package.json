{
  "name": "bitbyte",
  "version": "0.1.0",
  "private": true,
  "description": "BitByte Software Technology website: React client, Express API and shared validation (JavaScript only).",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "engines": {
    "node": ">=22.22.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,magenta \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:no-ts": "node scripts/check-no-typescript.js",
    "smoke": "node scripts/smoke.js",
    "check": "npm run check:no-ts && npm run lint && npm run format:check && npm test && npm run build && npm run smoke",
    "admin:create": "npm run admin:create -w server --",
    "admin:list": "npm run admin:list -w server --",
    "admin:reset-password": "npm run admin:reset-password -w server --",
    "admin:reset-2fa": "npm run admin:reset-2fa -w server --",
    "seed": "npm run seed -w server --",
    "secrets:generate": "npm run secrets:generate -w server --"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
